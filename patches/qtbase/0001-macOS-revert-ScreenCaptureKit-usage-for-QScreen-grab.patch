 #include <AppKit/AppKit.h>
 
 #include <guitest.h>
@@ -43,14 +40,6 @@ QPixmap grabWindowContents(QWidget * widget)
         qWarning() << "Grabbing pixmap failed, no QScreen for" << widget;
         return QPixmap();
     }
-
